
# >>> dsh-git-hygiene (auto 2026-09-11: перед первым GitHub push)
# secrets — никогда не коммитить
.env
.env.*
!.env.example
!.env.template
*.session
*.session-*
*.key
secrets/
# runtime junk
__pycache__/
*.pyc
.venv/
venv*/
node_modules/
.snapshots/
.pytest_cache/
.ruff_cache/
.fuse_hidden*
*.tmp.*
.codex-tmp/
.codegraph/
.claude/
*.log
# locks (пакетные lock-файлы остаются)
*.lock
!Cargo.lock
!flake.lock
# локальные базы/состояния
*.sqlite
*.sqlite-wal
*.sqlite-shm
# <<< dsh-git-hygiene

# >>> dsh-dev-only (use/dev split 2026-10-16)
# dev state and infra — не публикуется
.soc/
.tskgt/
.tmp-probes/
.dcm/
/patches/
reports/
# dev docs (каноны остаются в docs/canon/)
docs/*
!docs/canon/
# personal systemd/SSH/nginx infra (не публикуется — содержит личные пути, IP, VPS-хосты)
dsh-overrides/settings/web/
# dev root files
/AGENTS.md
/CLAUDE.md
/dsh-config-sync
/dsh-sync
/dsh-hooks.json
/colab-dsh-smoke.py
/test-dsh.sh
# <<< dsh-dev-only

# >>> dsh-stack-split (public release 2026-10-17)
# dsh-stack public parts tracked: settings.yaml.example, profiles/dsh-tui/cordis.patch.yml,
# profiles/dsh-tui/spot/ (plugin.mjs + lib + mcp-lazy + tests + registry + hide + lint),
# agent-presets/code-lazy/. Private parts below stay ignored.
dsh-stack/AGENTS.md
dsh-stack/.agent-presets/
dsh-stack/agent-presets/soc-gate/
dsh-stack/patches/
dsh-stack/profiles/dsh-tui/spot/logs/
dsh-stack/profiles/dsh-tui/spot/tools/
# <<< dsh-stack-split

# >>> dsh-dev-tooling (public release 2026-10-17)
# patch-stack management scripts — dev-only, not published
scripts/patch-stack-lint.sh
scripts/patch-stack-regen.sh
scripts/dsh-drift-detect.sh
scripts/generate-pristine-manifest.sh
scripts/git-hooks/
# SOC regression baselines — personal test infra
dsh-overrides/soc/
# core-patch backups (orig/.bak/.preNN) — dev-only, contains upstream snapshots
dsh-overrides/core-patches/backup/
# theme generation script — dev tooling (themes/generated/ already tracked)
dsh-overrides/scripts/
# <<< dsh-dev-tooling

# >>> dsh-dev-scripts (sec-clean 2026-10-16)
# dev-only reproduction/capture/archive — личные пути, не публикуется
dsh-overrides/archive/
dsh-overrides/core-patches/repro-*.mjs
dsh-overrides/patches/capture-*.mjs
dsh-overrides/patches/repro-*.mjs
dsh-overrides/dsh-tools-patches/
# <<< dsh-dev-scripts

# patch-stack-regen: generated consolidated patches (staging, not source)
dsh-overrides/patches/regen/

# >>> dsh-residual-sanitize (Step 0 sec-clean 2026-10-17)
# dev-only headless profile — содержит личные MCP paths (SOC/TermSeer/etc.)
dsh-overrides/settings/profile-headless.cordis.patch.yml
# dev docs с личными путями (public README = корневой README.md)
dsh-overrides/README.md
scripts/colab-verify-dsh-tui.md
# SOC regression baselines — personal test infra с личными путями
tests/golden/soc-cache-verification.yaml
tests/golden/fixtures/
tests/soc/
# <<< dsh-residual-sanitize

# >>> atomic-dsh-build (vendored build artifacts 2026-10-17)
# dist/ = built vendored tree (generated by scripts/build-package.sh on prepublishOnly)
# build-staging/ = temporary npm install dir for build
# plugins/ = built plugin bundle (mcp-lazy/code-lazy/spot) from dsh-stack sources
# themes/ = built themes bundle from dsh-overrides/themes/generated/
# *.tgz = npm pack output
# All included in package.json `files` for npm publish, but not committed.
dist/
build-staging/
plugins/
themes/
*.tgz
# <<< atomic-dsh-build
