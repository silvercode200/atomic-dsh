@@ -0,0 +1,50 @@
+/**
+ * dsh-overrides 35: user spinner-verb customization
+ * (settings.yaml `dsh-tui.spinnerVerbs {mode: replace|append, verbs[]}`).
+ *
+ * Pure normalization/resolution (no React, no channel): the plugin's apply
+ * chain normalizes the settings value, the channel stores it, and the
+ * spinner samples from resolveSpinnerVerbs(SPINNER_VERBS, custom) —
+ * 'append' (default) puts the user's verbs first so the sampling prefers
+ * them; 'replace' uses ONLY the user's list (falling back to the builtins
+ * when nothing valid survives cleaning).
+ */
+const VERB_MODES = new Set(['replace', 'append']);
+function cleanVerbs(verbs) {
+    if (!Array.isArray(verbs))
+        return [];
+    return verbs
+        .filter(v => typeof v === 'string' && v.trim() !== '')
+        .map(v => v.trim());
+}
+/**
+ * Normalize a raw settings value into `{mode, verbs}`, or undefined when
+ * the value carries no usable verbs (dead key — builtin sampling stands).
+ */
+export function normalizeSpinnerVerbs(value) {
+    if (value === null || typeof value !== 'object' || Array.isArray(value))
+        return undefined;
+    const verbs = cleanVerbs(value.verbs);
+    if (verbs.length === 0)
+        return undefined;
+    const mode = VERB_MODES.has(value.mode) ? value.mode : 'append';
+    return { mode, verbs };
+}
+/**
+ * Merge the builtin verb list with the user's custom list.
+ * @returns The effective sampling list.
+ */
+export function resolveSpinnerVerbs(builtin, custom) {
+    if (custom === undefined || custom === null)
+        return builtin;
+    const verbs = cleanVerbs(custom.verbs);
+    if (verbs.length === 0)
+        return builtin;
+    const mode = VERB_MODES.has(custom.mode) ? custom.mode : 'append';
+    if (mode === 'replace')
+        return verbs;
+    // append: user's verbs first, builtins deduped after (order-preserving)
+    const seen = new Set(verbs);
+    const tail = builtin.filter(v => !seen.has(v));
+    return [...verbs, ...tail];
+}
