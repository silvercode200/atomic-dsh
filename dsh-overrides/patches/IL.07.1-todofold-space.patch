  *
  * Works best inside a fullscreen (constrained-height root) Ink tree.
  */
-function ScrollBox({ children, ref, stickyScroll, ...style }) {
+// dsh-overrides 23: `contentJustify` opts the inner content box into a
+// justifyContent value (e.g. 'flex-end'). Chat's inline pinned frame keeps
+// the footer glued to the last terminal row; when the transcript is shorter
+// than the viewport, the freed rows used to open a blank band BETWEEN the
+// transcript end and the footer (collapsing the todo list grew the band by
+// exactly the list height — "alt+m does not give the area back"). Aligning
+// the content to the viewport bottom puts the slack ABOVE the transcript
+// instead, where it reads as ordinary empty terminal space. No-op whenever
+// the content fills the viewport (no slack for justifyContent to consume),
+// so scroll/culling behavior is untouched.
+function ScrollBox({ children, ref, stickyScroll, contentJustify, ...style }) {
     const domRef = useRef(null);
     // scrollTo/scrollBy bypass React: they mutate scrollTop on the DOM node,
     // mark it dirty, and call the root's throttled scheduleRender directly.
@@ -258,6 +268,6 @@
             overflowY: 'scroll'
         }, ...stickyScroll ? {
             stickyScroll: true
-        } : {}, children: _jsx(Box, { flexDirection: "column", flexGrow: 1, flexShrink: 0, width: "100%", children: children }) });
+        } : {}, children: _jsx(Box, { flexDirection: "column", flexGrow: 1, flexShrink: 0, width: "100%", ...(contentJustify ? { justifyContent: contentJustify } : {}), children: children }) });
 }
 export default ScrollBox;
