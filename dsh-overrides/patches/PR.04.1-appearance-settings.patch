+// dsh-overrides 31: the powerline status-row style selector. Settings
+// values normalize here so every consumer (StatusLine) sees the enum or
+// undefined — never a free-form string.
+const POWERLINE_STYLES = new Set(['full', 'plain', 'off']);
+/** Normalize an appearance.powerline value to the enum, else undefined. */
+export function normalizePowerlineStyle(value) {
+    return typeof value === 'string' && POWERLINE_STYLES.has(value) ? value : undefined;
+}
+/**
+ * Merge a partial `dsh-tui.appearance` settings value into the stable
+ * defaults (all three fields optional; invalid values drop per-field,
+ * same contract as normalizeStatusBar).
+ * - powerline: 'full' | 'plain' | 'off' (anything else → undefined);
+ * - theme: non-empty string after trim (availability is checked by the
+ *   consumer, ThemeProvider, which owns the theme catalog);
+ * - inputBorder: a customTheme color form (#rgb/#rrggbb/#rrggbbaa,
+ *   rgb(r,g,b), ansi256(n), ansi:name) after trim.
+ */
+export function normalizeAppearance(value) {
+    const normalized = { powerline: undefined, theme: undefined, inputBorder: undefined };
+    if (value === null || typeof value !== 'object' || Array.isArray(value))
+        return normalized;
+    const input = value;
+    normalized.powerline = normalizePowerlineStyle(input.powerline);
+    if (typeof input.theme === 'string' && input.theme.trim() !== '')
+        normalized.theme = input.theme.trim();
+    if (typeof input.inputBorder === 'string' && isValidThemeColor(input.inputBorder.trim()))
+        normalized.inputBorder = input.inputBorder.trim();
+    return normalized;
+}
