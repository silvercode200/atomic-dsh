+// dsh-overrides 17: mini-key-switcher status sources (spending + active model).
+// Pure helpers + a thin fetch layer for the dsh-tui status bar.
+//
+// Secret-safe by contract: tokens are read from local config files / env only,
+// are carried exclusively in the Authorization header, and are never logged,
+// rendered, or embedded in error messages.
+//
+// Sources (first match wins):
+//   token  — env MKS_SYNC_TOKEN | env SWITCHER_SYNC_TOKEN
+//          | refs.MKS_SYNC_TOKEN in ~/.dsh/.credentials.yaml
+//          | sync_token in ~/.config/mks/config.json
+//   base   — env MKS_BASE_URL | http://127.0.0.1:8350 (cli provider router)
+//   app    — env MKS_APP | 'dsh' (registered via POST /api/apps)
+import { readFileSync } from 'fs';
+import { homedir } from 'os';
+import { join } from 'path';
+
+const DEFAULT_BASE_URL = 'http://127.0.0.1:8350';
+const DEFAULT_APP = 'dsh';
+
+/** Read refs.MKS_SYNC_TOKEN from the .credentials.yaml without a YAML dep. */
+function readRefsToken(path) {
+    try {
+        const m = /^\s*MKS_SYNC_TOKEN:\s*(.+?)\s*$/m.exec(readFileSync(path, 'utf8'));
+        return m === null ? '' : m[1].replace(/^['"]|['"]$/g, '');
+    }
+    catch {
+        return '';
+    }
+}
+
+/** Read sync_token from the mks CLI config (JSON). */
+function readJsonSyncToken(path) {
+    try {
+        const parsed = JSON.parse(readFileSync(path, 'utf8'));
+        return typeof parsed.sync_token === 'string' ? parsed.sync_token : '';
+    }
+    catch {
+        return '';
+    }
+}
+
+/**
+ * Resolve the mini-key-switcher client config. Never throws: a missing or
+ * unreadable source simply degrades to an empty token (the status bar then
+ * renders no spending/actual-model field instead of failing).
+ */
+export function loadMksConfig(env = process.env, home = homedir()) {
+    return {
+        baseUrl: env.MKS_BASE_URL || DEFAULT_BASE_URL,
+        app: env.MKS_APP || DEFAULT_APP,
+        syncToken: env.MKS_SYNC_TOKEN
+            || env.SWITCHER_SYNC_TOKEN
+            || readRefsToken(join(home, '.dsh', '.credentials.yaml'))
+            || readJsonSyncToken(join(home, '.config', 'mks', 'config.json'))
+            || '',
+    };
+}
+
+/**
+ * Parse a GET /api/apps/{name}/spending payload into the flat shape the
+ * status bar needs. Returns undefined on any malformed payload so a half
+ * response can never render a wrong number.
+ */
+export function parseSpending(payload) {
+    if (payload === null || typeof payload !== 'object')
+        return undefined;
+    const summary = payload.summary;
+    if (summary === null || typeof summary !== 'object')
+        return undefined;
+    const requests = Number(summary.requests);
+    const costUsd = Number(summary.cost_usd);
+    if (!Number.isFinite(requests) || !Number.isFinite(costUsd))
+        return undefined;
+    const perModel = new Map();
+    const rows = Array.isArray(payload.rows) ? payload.rows : [];
+    for (const row of rows) {
+        if (row === null || typeof row !== 'object')
+            continue;
+        const key = typeof row.key === 'string' ? row.key : undefined;
+        if (key === undefined)
+            continue;
+        const count = Number(row.requests);
+        if (Number.isFinite(count))
+            perModel.set(key, count);
+    }
+    return { requests, costUsd, perModel };
+}
+
+/**
+ * Pick the currently active model from two consecutive spending snapshots:
+ * the model whose request count grew is the one serving traffic now. The
+ * switcher logs no session id and exposes no X-Model via its admin API, so a
+ * monotone delta between polls is the honest proxy for "the model actually
+ * running this session". Ties keep the earlier pick (stable).
+ */
+export function pickActiveModel(previous, current) {
+    if (previous === undefined || current === undefined)
+        return undefined;
+    let best;
+    let bestDelta = 0;
+    for (const [model, count] of current.perModel) {
+        const delta = count - (previous.perModel.get(model) ?? 0);
+        if (delta > bestDelta) {
+            bestDelta = delta;
+            best = model;
+        }
+    }
+    return best;
+}
+
+/**
+ * Fetch the 24h spending aggregation for the configured app.
+ * Returns undefined on any HTTP/parse failure — the field just stays hidden.
+ */
+export async function fetchMksSpending(cfg, signal) {
+    if (cfg.syncToken === '')
+        return undefined;
+    try {
+        const url = `${cfg.baseUrl}/api/apps/${encodeURIComponent(cfg.app)}/spending?period=24h`;
+        const res = await fetch(url, {
+            headers: { Authorization: `Bearer ${cfg.syncToken}` },
+            signal,
+        });
+        if (!res.ok)
+            return undefined;
+        return parseSpending(await res.json());
+    }
+    catch {
+        return undefined;
+    }
+}
+
+/** Format the spending figure: sub-cent costs keep a third decimal. */
+export function formatSpendingCost(costUsd) {
+    if (!Number.isFinite(costUsd))
+        return undefined;
+    const digits = costUsd > 0 && costUsd < 0.01 ? (costUsd < 0.001 ? 4 : 3) : 2;
+    return `$${costUsd.toFixed(digits)}`;
+}
