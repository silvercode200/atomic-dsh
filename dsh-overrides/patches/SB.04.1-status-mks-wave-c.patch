+/**
+ * dsh-overrides 17: poll the mini-key-switcher spending endpoint and derive
+ * the actually-routed model from consecutive snapshots (the model whose
+ * request count grew is the one serving traffic). Polling is silent: any
+ * failure leaves the fields hidden instead of rendering zeros or errors.
+ */
+function useMksStatus() {
+    const [state, setState] = React.useState({});
+    React.useEffect(() => {
+        const cfg = loadMksConfig();
+        if (cfg.syncToken === '')
+            return undefined;
+        let alive = true;
+        let last = undefined; // previous spending snapshot (delta source)
+        let actualModel;
+        const tick = async () => {
+            try {
+                const current = await fetchMksSpending(cfg);
+                if (!alive || current === undefined)
+                    return;
+                if (current.requests > 0) {
+                    actualModel = pickActiveModel(last, current) ?? actualModel;
+                    last = current;
+                    setState({ spending: current, actualModel });
+                }
+            }
+            catch {
+                // network hiccups keep the previous reading on screen
+            }
+        };
+        void tick();
+        const id = setInterval(() => void tick(), 20000);
+        return () => { alive = false; clearInterval(id); };
+    }, []);
+    return state;
+}
