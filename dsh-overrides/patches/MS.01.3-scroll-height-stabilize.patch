+// NOT the MessageList/smoothReveal reveal→delete→re-estimate floor-walk
+// family: in the user trace (24.09, 20:56 UTC) innerHeight and scrollHeight
+// flip IN LOCKSTEP (42/42 ↔ 39/39, maxScroll 0 in both) and base = ih−total
+// is constant — the message content height never changed, the viewport
+// chrome did. smoothReveal is uninvolved; this is the manual-scroll branch
+// patch 54 never covered (it pinned the sticky=true streaming branch).
+// Gated
+// wheels are a visual no-op: sticky stays untouched, no pendingScrollDelta,
+// no notify, no frame — matching native terminals, which no-op a wheel at
+// the bottom edge.
+export function wheelCannotLeaveBottom(dy, scrollTop, scrollHeight, viewportHeight) {
+    const maxScroll = Math.max(0, (scrollHeight ?? 0) - (viewportHeight ?? 0));
+    // Nothing scrollable: every position IS the bottom — up or down wheels
+    // have nowhere to go (and the renderer trivially at-bottom-restores any
+    // broken sticky here, so breaking it only bought the one-frame chrome
+    // flash).
+    if (maxScroll <= 0)
+        return true;
+    // Wheeling further DOWN while at/below the bottom: the drain would clamp
+    // straight back to maxScroll. +0.5 absorbs fractional Yoga dust so an
+    // integer scrollTop reads as at-bottom against a fractional maxScroll.
+    if (dy > 0 && (scrollTop ?? 0) + 0.5 >= maxScroll)
+        return true;
+    // Every other wheel (up from the bottom, down mid-content) really moves
+    // the view away from the bottom — sticky must break so the scrolled-up
+    // affordances (pinned prompt header, back-to-bottom pill) appear. Reading
+    // history is the feature; only the bottom-edge tremor was the bug.
+    return false;
+}
