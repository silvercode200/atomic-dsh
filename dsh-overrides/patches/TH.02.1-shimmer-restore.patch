+// dsh-overrides 28: shimmer keys are firmware, not palette. The brand
+// animations (GlimmerMessage base<->shimmer interpolation, the spinner
+// glyph's rainbow cycle) read claudeShimmer and the rainbow_*_shimmer
+// ladder; a third-party theme overlaying them flattens the signature
+// shimmer into one flat foreign color. After the overlay merge the base
+// palette's animation keys win back, so the shimmer keeps the brand hues
+// under any user theme. DSH_TUI_ALLOW_THEME_SHIMMER=1 bypasses the guard.
+const SHIMMER_FIRMWARE_KEYS = [
+    'claudeShimmer',
+    'rainbow_red_shimmer',
+    'rainbow_orange_shimmer',
+    'rainbow_yellow_shimmer',
+    'rainbow_green_shimmer',
+    'rainbow_blue_shimmer',
+    'rainbow_indigo_shimmer',
+    'rainbow_violet_shimmer',
+];
+/**
+ * Restore the animation-firmware keys a theme overlay may have flattened.
+ * @param merged - The palette after overlaying the theme's colors.
+ * @param base - The built-in palette the theme overlays.
+ * @returns The palette with the shimmer firmware keys taken from `base`.
+ */
+export function restoreShimmerFirmware(merged, base) {
+    if (process.env.DSH_TUI_ALLOW_THEME_SHIMMER === '1')
+        return merged;
+    const restored = { ...merged };
+    for (const key of SHIMMER_FIRMWARE_KEYS) {
+        restored[key] = base[key];
+    }
+    return restored;
+}
 /**
  * Overlay a spec's overrides onto its base palette.
  * @param spec - Validated theme spec.
  * @returns The full concrete palette.
  */
 export function buildTheme(spec) {
-    return { ...getTheme(spec.base), ...spec.colors };
+    const base = getTheme(spec.base);
+    return restoreShimmerFirmware({ ...base, ...spec.colors }, base);
 }
