+/**
+ * dsh-overrides 36: resolve the app background color. Theme-first
+ * design: the theme's `appBackground` key is the usual source (the
+ * themes script backfills every user theme); the settings value is an
+ * optional override; env DSH_TUI_BACKGROUND wins for tests/debugging.
+ * Each invalid layer is skipped (never throws); undefined = no paint.
+ * @returns A color string or undefined.
+ */
+export function resolveAppBackground(envValue, settingsValue, themeValue) {
+    if (typeof envValue === 'string' && isValidThemeColor(envValue))
+        return envValue;
+    if (typeof settingsValue === 'string' && isValidThemeColor(settingsValue))
+        return settingsValue;
+    if (typeof themeValue === 'string' && isValidThemeColor(themeValue))
+        return themeValue;
+    return undefined;
+}
