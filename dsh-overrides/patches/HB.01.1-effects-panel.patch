+/**
+ * dsh-overrides 38: persisted per-effect toggles for the /effects panel
+ * (~/.dsh-tui/effects.json, the same best-effort JSON pattern as
+ * themePrefs' theme.json). The panel writes here; the plugin's apply chain
+ * merges this interactive layer OVER the settings.yaml `appearance.effects`
+ * map (the file is the fresher, interactive source — same relation /theme's
+ * theme.json has to the boot default).
+ */
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { EFFECT_KEYS } from './animationsMode.js';
+import { DATA_DIR } from './utils/paths.js';
+const PREFS_DIR = DATA_DIR;
+/**
+ * The persisted effect map ({key: boolean}), unknown keys dropped.
+ * @param dir - Prefs directory (injectable for tests).
+ */
+export function readEffectsPref(dir = PREFS_DIR) {
+    try {
+        const parsed = JSON.parse(readFileSync(join(dir, 'effects.json'), 'utf8'));
+        if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed))
+            return {};
+        const effects = parsed.effects;
+        if (effects === null || typeof effects !== 'object' || Array.isArray(effects))
+            return {};
+        const out = {};
+        for (const key of EFFECT_KEYS) {
+            if (typeof effects[key] === 'boolean')
+                out[key] = effects[key];
+        }
+        return out;
+    }
+    catch {
+        return {};
+    }
+}
+/**
+ * Persist the full effect map (best effort).
+ * @returns True when the file was written.
+ */
+export function writeEffectsPref(effects, dir = PREFS_DIR) {
+    try {
+        mkdirSync(dir, { recursive: true });
+        const clean = {};
+        for (const key of EFFECT_KEYS) {
+            if (typeof effects[key] === 'boolean')
+                clean[key] = effects[key];
+        }
+        writeFileSync(join(dir, 'effects.json'), JSON.stringify({ effects: clean }, null, 2));
+        return true;
+    }
+    catch {
+        return false;
+    }
+}
