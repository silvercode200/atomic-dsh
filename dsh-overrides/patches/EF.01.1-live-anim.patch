+// dsh-overrides 30: the glyph cycles the rainbow_*_shimmer palette — the
+// same animation firmware the theme protects (dsh-overrides 28). One
+// palette step per spinner frame (120ms), smoothly interpolated between
+// neighbors: a full 7-color cycle every 840ms. The position derives from
+// the existing animation clock's `time`, so no new timer source; ANSI
+// palettes (no parseable RGB) fall back to the brand messageColor, and
+// the stall path (red interpolation) keeps precedence.
+const RAINBOW_SHIMMER_KEYS = [
+    'rainbow_red_shimmer',
+    'rainbow_orange_shimmer',
+    'rainbow_yellow_shimmer',
+    'rainbow_green_shimmer',
+    'rainbow_blue_shimmer',
+    'rainbow_indigo_shimmer',
+    'rainbow_violet_shimmer',
+];
+/** Interpolated palette color at animation time `time` (ms), or null. */
+function rainbowGlyphColor(theme, time) {
+    const palette = RAINBOW_SHIMMER_KEYS
+        .map(key => parseRGB(theme[key]))
+        .filter((rgb) => rgb !== null);
+    if (palette.length < 2)
+        return null;
+    const position = (time / 120) % palette.length;
+    const index = Math.floor(position);
+    const next = (index + 1) % palette.length;
+    return toRGBColor(interpolateColor(palette[index], palette[next], position - index));
+}
