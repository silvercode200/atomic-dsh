+/**
+ * dsh-overrides 77: lazy hub — /settings MCP & Tools section source of truth.
+ *
+ * Wave 1 (bin/dsh-setup.js) writes lazy-config.json as the canonical input;
+ * this module reads it back, lets the /settings hub toggle its fields, and
+ * regenerates cordis.patch.yml from it (the same string emission the wizard
+ * uses — re-applied at runtime so a hub toggle lands in the file the TUI
+ * loads as homePatchPath).
+ *
+ * lazy-config.json schema (canonical, written by dsh-setup.js):
+ *   {
+ *     "manager": <bool>,
+ *     "lazy-skills": <bool>,
+ *     "spot": <bool>,
+ *     "servers": [
+ *       { "name", "mode"|"always-on"|"lazy"|"off", "transport"|"stdio"|"streamable-http",
+ *         "command", "args", "url", "headers",
+ *         "autoActivate", "releaseOnTurnEnd", "schemaDelivery", "routingHints" }
+ *     ]
+ *   }
+ *
+ * cordis.patch.yml = top-level YAML array (the profile-layer patch the TUI
+ * loads as homePatchPath = $DSH_HOME/profiles/dsh-tui/cordis.patch.yml).
+ *
+ * Path resolution mirrors packaged-presets.js (`process.env.DSH_HOME ??
+ * ~/.dsh`). An optional @deepseek-ai/dsh-home-paths import is tried first
+ * (the package is a peer dep — present in some installs); the fallback is
+ * the same expression packaged-presets uses, so the two never disagree.
+ */
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join, dirname } from 'node:path';
+import { homedir } from 'node:os';
+import { createRequire } from 'node:module';
+
+const __require = createRequire(import.meta.url);
+let resolveDshHome = null;
+try {
+    // Optional peer dep — not installed in every layout (pnpm hoist). The
+    // fallback below resolves the same env var, so its absence is benign.
+    ({ resolveDshHome } = __require('@deepseek-ai/dsh-home-paths'));
+} catch {
+    resolveDshHome = null;
+}
+
+/** Resolve $DSH_HOME (env wins; ~/.dsh fallback) — same rule as packaged-presets.js. */
+function dshHome() {
+    if (typeof resolveDshHome === 'function') {
+        try { return resolveDshHome(); } catch { /* fall through */ }
+    }
+    return process.env.DSH_HOME || join(homedir(), '.dsh');
+}
+
+/** Profile-layer cordis.patch.yml path the TUI loads as homePatchPath. */
+export function profileCordisPath() {
+    return join(dshHome(), 'profiles', 'dsh-tui', 'cordis.patch.yml');
+}
+
+/** lazy-config.json path (sits next to cordis.patch.yml in the profile dir). */
+export function profileLazyConfigPath() {
+    return join(dshHome(), 'profiles', 'dsh-tui', 'lazy-config.json');
+}
+
+/** Default config when the file is absent or unparseable. */
+const DEFAULT_CFG = Object.freeze({
+    manager: false,
+    'lazy-skills': true,
+    spot: false,
+    servers: [],
+});
+
+/** Shape guard for a server entry (best-effort; bad entries are dropped, not fatal). */
+function isValidServerEntry(s) {
+    return s !== null && typeof s === 'object' && typeof s.name === 'string' && s.name !== '';
+}
+
+/** Read lazy-config.json; defaults on any read/parse failure. */
+export function readLazyConfig() {
+    try {
+        const txt = readFileSync(profileLazyConfigPath(), 'utf8');
+        const parsed = JSON.parse(txt);
+        if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed))
+            return { ...DEFAULT_CFG, servers: [] };
+        return {
+            manager: Boolean(parsed.manager),
+            'lazy-skills': parsed['lazy-skills'] !== false,
+            spot: Boolean(parsed.spot),
+            servers: Array.isArray(parsed.servers) ? parsed.servers.filter(isValidServerEntry) : [],
+        };
+    } catch {
+        return { ...DEFAULT_CFG, servers: [] };
+    }
+}
+
+/** Persist lazy-config.json (pretty-printed; mkdir -p the profile dir). */
+export function writeLazyConfig(cfg) {
+    const p = profileLazyConfigPath();
+    mkdirSync(dirname(p), { recursive: true });
+    const out = {
+        manager: Boolean(cfg.manager),
+        'lazy-skills': cfg['lazy-skills'] !== false,
+        spot: Boolean(cfg.spot),
+        servers: Array.isArray(cfg.servers) ? cfg.servers.filter(isValidServerEntry) : [],
+    };
+    writeFileSync(p, JSON.stringify(out, null, 2) + '\n');
+    return p;
+}
+
+/** Quote a scalar for YAML emission (mirrors bin/dsh-setup.js yamlScalar). */
+function yamlScalar(s) {
+    if (s === '') return "''";
+    if (typeof s !== 'string') s = String(s);
+    if (/^[\d.-]/.test(s) || s === 'true' || s === 'false' || s === 'null' || /[:#{}\[\],&*?|<>=!%@`]/.test(s)) {
+        return JSON.stringify(s);
+    }
+    return s;
+}
+
+/** Always-on entry: direct @deepseek-ai/dsh-mcp-client (always visible to model). */
+function emitDirectEntry(spec, lines) {
+    lines.push(`    - id: mcp-${spec.name}`);
+    lines.push(`      name: '@deepseek-ai/dsh-mcp-client'`);
+    lines.push(`      config:`);
+    lines.push(`        serverName: ${yamlScalar(spec.name)}`);
+    lines.push(`        transport: ${spec.transport ?? 'stdio'}`);
+    if ((spec.transport ?? 'stdio') === 'stdio') {
+        if (typeof spec.command === 'string' && spec.command !== '') {
+            lines.push(`        command: ${yamlScalar(spec.command)}`);
+        }
+        if (Array.isArray(spec.args) && spec.args.length > 0) {
+            lines.push(`        args:`);
+            for (const a of spec.args) lines.push(`          - ${yamlScalar(a)}`);
+        }
+    } else if (spec.transport === 'streamable-http' && spec.url) {
+        lines.push(`        url: ${yamlScalar(spec.url)}`);
+        if (spec.headers && Object.keys(spec.headers).length > 0) {
+            lines.push(`        headers:`);
+            for (const [k, v] of Object.entries(spec.headers)) {
+                lines.push(`          ${yamlScalar(k)}: ${yamlScalar(v)}`);
+            }
+        }
+    }
+    lines.push(`        failOnStartupError: false`);
+}
+
+/** Lazy entry: @yilinxiao/dsh-mcp-lazy (auto-activate on tool call). */
+function emitLazyEntry(spec, lines) {
+    lines.push(`    - id: mcp-lazy-${spec.name}`);
+    lines.push(`      name: '@yilinxiao/dsh-mcp-lazy'`);
+    lines.push(`      config:`);
+    lines.push(`        transport: ${spec.transport ?? 'stdio'}`);
+    lines.push(`        serverName: ${yamlScalar(spec.name)}`);
+    if ((spec.transport ?? 'stdio') === 'stdio') {
+        if (typeof spec.command === 'string' && spec.command !== '') {
+            lines.push(`        command: ${yamlScalar(spec.command)}`);
+        }
+        if (Array.isArray(spec.args) && spec.args.length > 0) {
+            lines.push(`        args:`);
+            for (const a of spec.args) lines.push(`          - ${yamlScalar(a)}`);
+        }
+    } else if (spec.transport === 'streamable-http' && spec.url) {
+        lines.push(`        url: ${yamlScalar(spec.url)}`);
+        if (spec.headers && Object.keys(spec.headers).length > 0) {
+            lines.push(`        headers:`);
+            for (const [k, v] of Object.entries(spec.headers)) {
+                lines.push(`          ${yamlScalar(k)}: ${yamlScalar(v)}`);
+            }
+        }
+    }
+    lines.push(`        autoActivate: false`);
+    lines.push(`        releaseOnTurnEnd: true`);
+    lines.push(`        schemaDelivery: message`);
+    if (Array.isArray(spec.routingHints) && spec.routingHints.length > 0) {
+        lines.push(`        routingHints: [${spec.routingHints.map(h => yamlScalar(h)).join(', ')}]`);
+    }
+}
+
+/**
+ * Generate cordis.patch.yml text from a lazy-config.json object.
+ * Reuses the wizard's string-emission logic (bin/dsh-setup.js
+ * buildCordisPatch/emitDirectEntry/emitLazyEntry) — same entry shape,
+ * input is lazyConfig instead of wizard answers.
+ * @param {{manager:boolean, 'lazy-skills':boolean, spot:boolean, servers:Array}} cfg
+ * @returns {string}
+ */
+export function generateCordisPatch(cfg) {
+    /** @type {string[]} */
+    const lines = ['# cordis.patch.yml — generated from lazy-config.json by dsh HB.08', ''];
+    const servers = Array.isArray(cfg.servers) ? cfg.servers : [];
+    // Always-on servers — direct @deepseek-ai/dsh-mcp-client entries.
+    const alwaysOn = servers.filter(s => s.mode === 'always-on');
+    if (alwaysOn.length > 0) {
+        lines.push('# Always-on MCP servers (direct stdio, always visible to model)');
+        lines.push('- insert:');
+        for (const spec of alwaysOn) emitDirectEntry(spec, lines);
+        lines.push('');
+    }
+    // Lazy servers (exclude spot — emitted as a separate plugin insert).
+    const lazy = servers.filter(s => s.mode === 'lazy' && s.name !== 'spot');
+    if (lazy.length > 0) {
+        lines.push('# Lazy MCP servers (auto-activate on tool call, release on turn end)');
+        lines.push('- insert:');
+        for (const spec of lazy) emitLazyEntry(spec, lines);
+        lines.push('');
+    }
+    // MCP auto-takeover manager.
+    if (cfg.manager) {
+        lines.push('# MCP auto-takeover manager (hides TaskGate/octa behind lazy proxy)');
+        lines.push('- id: mcp-lazy-manager');
+        lines.push(`  name: '@yilinxiao/dsh-mcp-lazy'`);
+        lines.push(`  config:`);
+        lines.push(`    mode: manager`);
+        lines.push('');
+    } else {
+        lines.push('# MCP auto-takeover manager — OFF (TaskGate/octa stay direct stdio)');
+        lines.push('- id: mcp-lazy-manager');
+        lines.push(`  disabled: true`);
+        lines.push('');
+    }
+    // spot cold-discovery gate.
+    if (cfg.spot) {
+        lines.push('# spot cold-discovery gate enabled');
+        lines.push(`- insert:`);
+        lines.push(`  - id: spot`);
+        lines.push(`    name: './spot/plugin.mjs'`);
+        lines.push('');
+    } else {
+        lines.push('# spot cold-discovery gate — disabled');
+        lines.push('');
+    }
+    return lines.join('\n');
+}
+
+/** Write cordis.patch.yml from cfg (mkdir -p the profile dir first). */
+export function writeProfileCordisPatch(cfg) {
+    const p = profileCordisPath();
+    mkdirSync(dirname(p), { recursive: true });
+    writeFileSync(p, generateCordisPatch(cfg));
+    return p;
+}
+
+/** Mode cycle: always-on → lazy → off → always-on. */
+export function cycleMode(mode) {
+    if (mode === 'always-on') return 'lazy';
+    if (mode === 'lazy') return 'off';
+    return 'always-on';
+}
