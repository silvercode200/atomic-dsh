+/**
+ * dsh-overrides 41: measurable-tool progress — parse the FINAL output of a
+ * finished tool call for the known progress patterns (curl, wget, python
+ * tqdm) and render a sub-cell mini-bar into the tool card.
+ *
+ * HONEST SCOPE (the node's investigation, reports/hub-wave-20260918.md):
+ * the channel does NOT stream a running tool's output — tool/result lands
+ * once, on completion (channel.js case 'tool/result'; assistant/chunk only
+ * carries text/reasoning/call-ARGUMENTS). So this is a RETROSPECTIVE bar:
+ * the last-known progress from the finished output, next to the elapsed
+ * time — not a live download feed. The card's elapsed clock is the only
+ * live signal while the tool runs.
+ */
+
+/** Extract the LAST curl/wget/tqdm progress reading from a tool output. */
+export function parseToolProgress(text) {
+    if (typeof text !== 'string' || text === '')
+        return undefined;
+    const lines = text.split(/\r?\n/);
+    // last matching line wins — the tail carries the freshest reading
+    for (let i = lines.length - 1; i >= 0; i--) {
+        const hit = parseLine(lines[i]);
+        if (hit !== undefined)
+            return hit;
+    }
+    return undefined;
+}
+
+function clampPercent(value) {
+    if (!Number.isFinite(value))
+        return undefined;
+    return Math.max(0, Math.min(100, Math.round(value)));
+}
+
+function parseLine(line) {
+    // curl classic columnar: " 45 12.3M 0 45 5600k 0 0:00:02 0:00:02 2700k"
+    // (percent-total received-xfer total-xfer avg-speed … current-speed)
+    const curlCols = /^\s*(\d{1,3})\s+[\d.]+[KMGT]?i?B?\s+\d+\s+[\d.]+[KMGT]?\s+/.exec(line);
+    if (curlCols !== null && +curlCols[1] <= 100) {
+        // curl prints its speeds as bare scaled numbers (2700k, 8.1M) after
+        // the two time columns — and sometimes with an explicit /s suffix.
+        // curl scales with LOWERCASE k/M suffixes — accept both cases.
+        const speed = (/\d+:\d+:\d+\s+([\d.]+[KMGTkmgt](?:B)?\/s)/.exec(line)?.[1])
+            ?? (/\d+:\d+:\d+\s+\d+:\d+:\d+\s+([\d.]+[KMGTkmgt])\s*$/.exec(line)?.[1]);
+        return { kind: 'curl', percent: clampPercent(+curlCols[1]), speed };
+    }
+    // curl progress-bar tail: "## 100%[===>] 12.58M  5.60MB/s" (and friends)
+    const curlBar = /(\d{1,3})%\s*\[/.exec(line);
+    if (curlBar !== null && /=>*\]/.test(line) && /[\d.]+[KMGT]?B\/s/.test(line)) {
+        return {
+            kind: 'curl',
+            percent: clampPercent(+curlBar[1]),
+            speed: /([\d.]+[KMGT]B\/s)/.exec(line)?.[1],
+        };
+    }
+    // wget: "[=====>   ] 12,345  45.6M/s  (27%)" — the trailing percent wins
+    const wget = /\[[=>\s]*\]\s+[\d,.]+\s+([\d.]+[KMGT]?B?\/s)?\s*\((\d{1,3})%\)/.exec(line);
+    if (wget !== null) {
+        return { kind: 'wget', percent: clampPercent(+wget[2]), speed: wget[1] };
+    }
+    // tqdm: " 57%|█████▎  | 57/100 [00:03<00:02, 19.1it/s]"
+    const tqdm = /(\d{1,3})%\s*\|[#█▏▎▍▌▋▊▉ ]*\|\s*\d+\/\d+\s*\[[^\]]*,\s*([\d.]+\s*\w+\/s)\]/.exec(line);
+    if (tqdm !== null) {
+        return { kind: 'tqdm', percent: clampPercent(+tqdm[1]), speed: tqdm[2].replace(/\s+/g, '') };
+    }
+    // wget without speed: "[====>  ] 12,345/45,678  27%" or "(27%)" forms
+    const wgetPlain = /\[[=>\s]*\]\s+[\d,.]+\/[\d,.]+\s+\(?(\d{1,3})%\)?/.exec(line);
+    if (wgetPlain !== null) {
+        return { kind: 'wget', percent: clampPercent(+wgetPlain[1]), speed: undefined };
+    }
+    return undefined;
+}
+
+const SUB = ['', '▏', '▎', '▍', '▌', '▋', '▊', '▉'];
+
+/** Sub-cell mini-bar for a parsed progress (eighths, patch-40 mechanics). */
+export function toolProgressCells(progress, cells = 8) {
+    const frac = progress?.percent === undefined ? 0 : progress.percent / 100;
+    if (cells <= 0)
+        return { fill: '', track: '' };
+    const eighths = Math.round(frac * cells * 8);
+    const whole = Math.min(cells, Math.floor(eighths / 8));
+    const rem = whole < cells ? eighths % 8 : 0;
+    const fill = '█'.repeat(whole) + (rem > 0 ? SUB[rem] : '');
+    return { fill, track: '·'.repeat(Math.max(0, cells - fill.length)) };
+}
