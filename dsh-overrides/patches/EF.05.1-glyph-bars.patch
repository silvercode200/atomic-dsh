+/**
+ * dsh-overrides 40: per-character text gradient — each grapheme gets the
+ * pair color interpolated by its position ALONG the word and a slow time
+ * phase (cosine, so t=0 is exactly `base` everywhere, t=periodMs/2 is
+ * `highlight` everywhere; between them the hue travels across the word).
+ * Returns an ANSI string (chalk) to drop into a Text child.
+ */
+export function gradientText(word, time, base, highlight, periodMs = 2400) {
+    const phase = (1 - Math.cos((time / periodMs) * 2 * Math.PI)) / 2;
+    const segments = [...getGraphemeSegmenter().segment(word)];
+    // A traveling FRONT: phase 0 = the whole word sits on `base`; as the
+    // phase grows the highlight crest crosses the word left-to-right (each
+    // crossed segment fully highlighted, the one under the front blended);
+    // phase 1 = the whole word sits on `highlight`. The crest then travels
+    // back the same way (cosine period).
+    const total = segments.length;
+    let out = '';
+    segments.forEach(({ segment }, index) => {
+        const t = Math.min(1, Math.max(0, phase * (total + 1) - index));
+        const rgb = interpolateColor(base, highlight, t);
+        // raw truecolor SGR — no chalk dependency: the gradient must paint
+        // identically under tests (no TTY) and the live TUI.
+        out += `\x1b[38;2;${rgb.r};${rgb.g};${rgb.b}m${segment}\x1b[0m`;
+    });
+    return out;
+}
+
+/**
+ * dsh-overrides 40: gradient bar fill — N cells, each an eighth-block glyph
+ * string with the pair color interpolated along the bar (first cell ≈ base
+ * at phase 0, last ≈ highlight at phase 1; the time phase slides the whole
+ * ramp). Returns one ANSI-painted string per cell.
+ */
+export function gradientBarFill(cells, base, highlight, phase) {
+    const out = [];
+    for (let i = 0; i < cells; i++) {
+        const t = Math.min(1, Math.max(0, phase)) * (cells <= 1 ? 1 : i / (cells - 1));
+        const rgb = interpolateColor(base, highlight, t);
+        out.push(`\x1b[38;2;${rgb.r};${rgb.g};${rgb.b}m█\x1b[0m`);
+    }
+    return out;
+}
