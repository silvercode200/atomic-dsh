+// DSH-P75-SATURATION-OPTION: apply the user's saturation preference to a
+// built palette. Each value parseRGB can parse (rgb(r,g,b) or #hex) gets
+// its saturation scaled; non-color values (ansi:, ansi256(), etc.) pass
+// through untouched. multiplier: muted=0.6, vivid=1.4, moderate/other=1.0.
+const SATURATION_MULTIPLIERS = { muted: 0.6, moderate: 1.0, vivid: 1.4 };
+/**
+ * Apply saturation adjustment to every parsable color value in a palette.
+ * @param palette - The built theme palette (key → color string).
+ * @param saturation - 'muted' | 'moderate' | 'vivid' | undefined.
+ * @returns A new palette with adjusted color values (or the original if no-op).
+ */
+function applySaturationToPalette(palette, saturation) {
+    const multiplier = SATURATION_MULTIPLIERS[saturation] ?? 1.0;
+    if (multiplier === 1.0)
+        return palette;
+    const result = { ...palette };
+    for (const key of Object.keys(result)) {
+        const value = result[key];
+        if (typeof value !== 'string')
+            continue;
+        const rgb = parseRGB(value);
+        if (rgb !== null)
+            result[key] = toRGBColor(adjustSaturation(rgb, multiplier));
+    }
+    return result;
+}
