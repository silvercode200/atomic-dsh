+/**
+ * dsh-overrides 44: the interactive preference layer — the SAME
+ * best-effort JSON mechanism /theme (theme.json) and /effects
+ * (effects.json) use, extended to a general customization store:
+ * ~/.dsh-tui/appearance.json { appearance: {...}, effects: {...} }.
+ *
+ * The effects.json file stays fully supported (patch 38 semantics); the
+ * hub writes appearance.json and the plugin's apply chain merges BOTH
+ * interactive files OVER the settings.yaml layer (file wins per key —
+ * the fresher interactive choice beats the declarative base, exactly
+ * like theme.json vs the boot default).
+ */
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { DATA_DIR } from './utils/paths.js';
+const PREFS_DIR = DATA_DIR;
+const EMPTY = { appearance: {}, effects: {} };
+/** Read the interactive layer ({appearance, effects}; empty when absent/corrupt). */
+export function readAppearancePref(dir = PREFS_DIR) {
+    try {
+        const parsed = JSON.parse(readFileSync(join(dir, 'appearance.json'), 'utf8'));
+        if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed))
+            return { appearance: {}, effects: {} };
+        return {
+            appearance: (parsed.appearance !== null && typeof parsed.appearance === 'object' && !Array.isArray(parsed.appearance)) ? parsed.appearance : {},
+            effects: (parsed.effects !== null && typeof parsed.effects === 'object' && !Array.isArray(parsed.effects)) ? parsed.effects : {},
+        };
+    }
+    catch {
+        return { appearance: {}, effects: {} };
+    }
+}
+/** Persist the interactive layer (best effort). */
+export function writeAppearancePref(pref, dir = PREFS_DIR) {
+    try {
+        mkdirSync(dir, { recursive: true });
+        writeFileSync(join(dir, 'appearance.json'), JSON.stringify({
+            appearance: pref.appearance ?? {},
+            effects: pref.effects ?? {},
+        }, null, 2));
+        return true;
+    }
+    catch {
+        return false;
+    }
+}
+/**
+ * Merge the interactive appearance layer OVER the settings value: file
+ * keys win, settings-only keys survive.
+ */
+export function mergeAppearanceOver(settingsAppearance, fileAppearance) {
+    return { ...(settingsAppearance ?? {}), ...(fileAppearance ?? {}) };
+}
