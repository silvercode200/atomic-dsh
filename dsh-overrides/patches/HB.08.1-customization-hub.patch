+/**
+ * dsh-overrides 44: the customization-hub section registry. A section is
+ * ONE entry here — {id, title} — plus a component the hub renders for it
+ * (wired in CustomizationHub.js). Adding a future section = add an entry +
+ * a component: the hub root, navigation and the /effects argument jump all
+ * pick it up automatically (the plugin-like extension point the user asked
+ * for; see reports/hub-wave-20260918.md «как добавить секцию»).
+ */
+export const HUB_SECTIONS = [
+    { id: 'appearance', title: 'Оформление' },
+    { id: 'effects', title: 'Эффекты' },
+    { id: 'theme', title: 'Тема' },
+    { id: 'border', title: 'Рамка' },
+    { id: 'spinner', title: 'Спиннеры' },
+    { id: 'statusrow', title: 'Статус-ряд' },
+    { id: 'progress', title: 'Прогресс' },
+];
+/** Find a section by id (the /effects <section> argument jump). */
+export function hubSectionById(id) {
+    return HUB_SECTIONS.find(section => section.id === id);
+}
