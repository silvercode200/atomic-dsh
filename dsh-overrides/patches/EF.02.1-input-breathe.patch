+/**
+ * dsh-overrides 33: process-wide gate + per-effect registry for the LIVE42
+ * animation wave. Mirrors minimalMode.js: the channel's setAppearance pushes
+ * the normalized settings values here, leaf components read effectEnabled()
+ * instead of threading the channel through four render layers.
+ *
+ * Modes (`dsh-tui.appearance.animations`, env DSH_TUI_ANIMATIONS on top):
+ *   full   — every effect on (default);
+ *   custom — per-effect opt-out via `dsh-tui.appearance.effects`
+ *            `{<key>: boolean}`; an UNSET key means ON (opt-out semantics);
+ *   off    — the whole wave static.
+ * DSH_TUI_REDUCED_MOTION=1 disables everything over any mode (the upstream
+ * spinner reduced-motion is prop-threaded with no global source; this env
+ * is the wave's reduced-motion channel).
+ *
+ * Effect registry (each animation site reads its own flag):
+ *   inputBorderBreath (33), todoPulse (34), todoProgressBar (34),
+ *   headerGlimmer (34), ctxBarBreath (34), toolCardShimmer (35),
+ *   spinnerRainbow (30), spinnerGlimmer (28).
+ */
+import { interpolateColor, toRGBColor } from './components/Spinner/spinnerUtils.js';
+/** The LIVE42 effect registry (single source of truth for schema + panel). */
+export const EFFECT_KEYS = [
+    'inputBorderBreath',
+    'todoPulse',
+    'todoProgressBar',
+    'headerGlimmer',
+    'ctxBarBreath',
+    'toolCardShimmer',
+    'spinnerRainbow',
+    'spinnerGlimmer',
+];
+const ANIMATION_MODES = new Set(['full', 'custom', 'off']);
+const EFFECT_KEY_SET = new Set(EFFECT_KEYS);
+let animationsSetting; // 'full' | 'custom' | 'off' | undefined
+let effectsSetting; // {key: boolean} partial (custom mode)
+/** @internal channel-owned setter; also called once at boot. */
+export function setAnimationsMode(mode) {
+    animationsSetting = ANIMATION_MODES.has(mode) ? mode : undefined;
+}
+/** @internal channel-owned setter for the custom-mode per-effect map. */
+export function setEffectsMode(effects) {
+    const out = {};
+    if (effects !== null && typeof effects === 'object' && !Array.isArray(effects)) {
+        for (const key of EFFECT_KEYS) {
+            if (typeof effects[key] === 'boolean')
+                out[key] = effects[key];
+        }
+    }
+    effectsSetting = out;
+}
+/** The active mode with env precedence resolved ('full' default). */
+export function animationsMode() {
+    const env = process.env.DSH_TUI_ANIMATIONS;
+    if (ANIMATION_MODES.has(env))
+        return env;
+    return animationsSetting ?? 'full';
+}
+/** Whether ANY of the wave's animations may run (mode !== off). */
+export function animationsEnabled() {
+    return animationsMode() !== 'off';
+}
+/**
+ * Whether a specific effect may animate. reduced-motion > mode > per-key.
+ * @param key - One of EFFECT_KEYS; unknown keys answer false (fail-static).
+ */
+export function effectEnabled(key) {
+    if (process.env.DSH_TUI_REDUCED_MOTION === '1')
+        return false;
+    if (!EFFECT_KEY_SET.has(key))
+        return false;
+    const mode = animationsMode();
+    if (mode === 'off')
+        return false;
+    if (mode === 'full')
+        return true;
+    // custom: unset key means ON (opt-out)
+    return effectsSetting?.[key] !== false;
+}
+/**
+ * Idle-breathing color: a slow cosine (t=0 sits exactly on `base`,
+ * t=periodMs/2 on `highlight`, t=periodMs back on `base`) interpolating
+ * between the two colors. `time` is the shared animation clock's elapsed ms.
+ * @returns An `rgb(r,g,b)` string for Ink's color prop.
+ */
+export function breathingColor(base, highlight, time, periodMs) {
+    const phase = (1 - Math.cos((time / periodMs) * 2 * Math.PI)) / 2;
+    return toRGBColor(interpolateColor(base, highlight, phase));
+}
