+/**
+ * dsh-overrides 39: human descriptions for the LIVE42 effect registry
+ * (one per EFFECT_KEYS entry): what the effect does and where it lives in
+ * the UI — shown in the /effects panel's detail block. Russian, 1-2 lines.
+ * A missing entry is a warn (never fatal): getEffectDescription falls back
+ * to the key itself so the panel always renders.
+ */
+import { EFFECT_KEYS } from './animationsMode.js';
+/** key → русское описание (что делает + где в UI). */
+export const EFFECT_DESCRIPTIONS = {
+    inputBorderBreath: 'Рамка поля ввода плавно дышит между акцентным цветом и его shimmer-вариантом; при работающем ходе — вдвое быстрее',
+    todoPulse: 'Активная задача в todo-панели пульсирует глифом ◐ (toolDotTask ↔ более светлый гребень)',
+    todoProgressBar: 'В заголовке todo-панели мини-бар прогресса из 5 ячеек вместо текста ✓ 0/2',
+    headerGlimmer: 'Заголовок todo-панели переливается бегущим окном подсветки',
+    ctxBarBreath: 'Бар контекста в статус-строке дышит яркостью, пока идёт ход модели',
+    toolCardShimmer: 'Заголовок карточки terminal-инструмента мерцает тоном bashBorder, пока команда выполняется',
+    spinnerRainbow: 'Глиф спиннера плавно циклирует радужную палитру shimmer-оттенков',
+    spinnerGlimmer: 'Глагол под спиннером переливается бегущим окном подсветки',
+};
+/**
+ * The description for a registry key, or the key itself (with a warn) when
+ * the catalog lacks an entry — the panel must never crash on a gap.
+ */
+export function getEffectDescription(key) {
+    const text = EFFECT_DESCRIPTIONS[key];
+    if (text === undefined) {
+        console.warn(`[dsh-tui] effects: no description for "${key}" (effectsCatalog)`);
+        return key;
+    }
+    return text;
+}
+// Keep the mapping honest: a registry key without a description warns at
+// module load (once), not on every render.
+for (const key of EFFECT_KEYS) {
+    if (!(key in EFFECT_DESCRIPTIONS))
+        console.warn(`[dsh-tui] effects: no description for "${key}" (effectsCatalog)`);
+}
