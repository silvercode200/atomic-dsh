     /**
+     * dsh-overrides 32: the panel MOUNT re-anchors the frame. The startup
+     * context panel appears asynchronously (loadedContext lands after boot)
+     * and grows the main-screen transcript by the same +2 rows as the
+     * Ctrl+P toggle above — but nothing invalidated the renderer for the
+     * mount, so the first frames after startup could reuse stale blank
+     * cells (misaligned intro row, stray blank lines — until the next full
+     * repaint, e.g. the /-menu). Mirror the toggle's invalidate/reanchor on
+     * the false→true transition of loadedContextVisible.
+     */
+    const loadedContextShownRef = React.useRef(loadedContextVisible);
+    React.useEffect(() => {
+        const wasShown = loadedContextShownRef.current;
+        loadedContextShownRef.current = loadedContextVisible;
+        if (!wasShown && loadedContextVisible) {
+            const ink = instances.get(process.stdout) ?? instances.values().next().value;
+            ink?.invalidatePrevFrame();
+            ink?.reanchorViewport();
+        }
+    }, [loadedContextVisible]);
