+/**
+ * dsh-overrides 42: braille sparklines for the status row (OPT-IN only,
+ * custom mode): (a) token throughput tps, (b) cache-hit percent.
+ *
+ * A sparkline packs 2 columns x 4 rows of dots into ONE braille glyph —
+ * a 16-dot micro-graph per character cell. History: a render-driven
+ * ring buffer (each StatusLine render pushes the current reading), so
+ * the graph accumulates over the session without new timers.
+ *
+ * Cache honesty: routes that do not report cache fields (golden
+ * channel-probe) get NO sparkline — cacheHitPct returns undefined and
+ * the field hides itself; it never fakes a zero.
+ */
+/** Rows of the braille dot grid, bottom-to-top bit weights (col-major). */
+const BRAILLE_OFFSET = 0x2800;
+// dot layout per glyph (2 cols x 4 rows):
+//  col0: rows 0..3 -> bits 0x01 0x02 0x04 0x40   col1: 0x08 0x10 0x20 0x80
+const DOT = [
+    [0x01, 0x08], // row 0 (top)
+    [0x02, 0x10],
+    [0x04, 0x20],
+    [0x40, 0x80], // row 3 (bottom)
+];
+/**
+ * Render a braille sparkline of `values` into at most `width` glyphs.
+ * Values map linearly to the 8-dot vertical resolution; NaN/undefined
+ * samples are skipped (they leave a blank column).
+ * @returns The braille string ('' for no usable values).
+ */
+export function sparkline(values, width = 10) {
+    const clean = (values ?? []).filter(v => Number.isFinite(v));
+    if (clean.length === 0 || width <= 0)
+        return '';
+    const cols = Math.min(width * 2, clean.length);
+    // downsample: pick evenly spaced values when history is longer
+    const step = clean.length / cols;
+    const picked = [];
+    for (let i = 0; i < cols; i++)
+        picked.push(clean[Math.min(clean.length - 1, Math.floor(i * step))]);
+    const min = Math.min(...picked);
+    const max = Math.max(...picked);
+    const span = max - min;
+    let out = '';
+    for (let c = 0; c < picked.length; c += 2) {
+        let bits = 0;
+        for (let col = 0; col < 2; col++) {
+            const v = picked[c + col];
+            if (v === undefined)
+                continue;
+            // 0..1 position on the 8-dot height; flat series -> mid line
+            const t = span === 0 ? 0.5 : (v - min) / span;
+            const height = Math.max(1, Math.round(t * 8));
+            for (let row = 0; row < 4; row++) {
+                // row 0 is TOP: dots from bottom (row 3) upward
+                const fromBottom = 3 - row;
+                const filled = height > fromBottom * 2;
+                const partial = height === fromBottom * 2 + 1;
+                if (filled || partial)
+                    bits |= DOT[row][col];
+            }
+        }
+        out += String.fromCodePoint(BRAILLE_OFFSET + bits);
+    }
+    return out;
+}
+/** A fresh ring buffer of `max` samples. */
+export function newBuffer(max = 40) {
+    return { max, values: [] };
+}
+/** Push one finite sample; returns the (possibly new) buffer. */
+export function pushSample(buffer, value) {
+    if (buffer === undefined || buffer === null)
+        return buffer;
+    if (!Number.isFinite(value))
+        return buffer;
+    const values = [...buffer.values, value];
+    if (values.length > buffer.max)
+        values.splice(0, values.length - buffer.max);
+    return { max: buffer.max, values };
+}
+/**
+ * Cache-hit percent from a usage record: cacheRead of the total prompt
+ * mass. Undefined when the route does not report cache fields — the
+ * caller must HIDE the sparkline, never fake a zero.
+ */
+export function cacheHitPct(usage) {
+    if (usage === null || typeof usage !== 'object')
+        return undefined;
+    const { input, cacheRead, cacheWrite } = usage;
+    if (typeof input !== 'number' || typeof cacheRead !== 'number' || typeof cacheWrite !== 'number')
+        return undefined;
+    const total = input + cacheRead + cacheWrite;
+    if (total <= 0)
+        return undefined;
+    return (cacheRead / total) * 100;
+}
