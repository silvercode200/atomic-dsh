# 49-logo-version: стартовый логотип показывает версию форка — суффикс +p<N>
# после базовой версии (v0.10.0-beta.4+p49). N = max числовой префикс записей
# реестра патчей (26b-*.patch даёт 26); apply-скрипт генерирует мета-файл
# lib/types/components/forkVersion.js в живом пакете (НЕ входит в реестр —
# генерируется, не патчится). LogoV2 читает его через createRequire +
# require(esm) (пакет ESM type:module — голый require не существует; CJS
# module.exports в .js этого пакета = ReferenceError «module is not defined»)
# с fallback '' → стоковый вид версии. dimColor и wrap:"truncate-end"
# родительского Text сохранены.
--- a/lib/types/components/LogoV2.js
+++ b/lib/types/components/LogoV2.js
