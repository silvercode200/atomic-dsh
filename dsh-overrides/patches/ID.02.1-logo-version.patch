 import { useTheme } from './design-system/ThemeProvider.js';
@@ -29,6 +30,23 @@
         return '0.1.0';
     }
 })();
+// dsh-overrides 49: fork version suffix (+p<N>) — the patch-stack depth.
+// scripts/apply-dsh-overrides.sh regenerates ./forkVersion.js with the
+// registry's max numeric patch prefix (26b-… counts as 26; this patch itself
+// is 49). Plain `require` does not exist in this ESM package (type:module),
+// so the require is created via createRequire and the ESM file loads through
+// require(esm) (Node >= 22.12 — the pinned local/colab runtime). Missing or
+// unreadable → no suffix, stock version display.
+const forkSuffix = (() => {
+    try {
+        const req = createRequire(import.meta.url);
+        const forkPatch = req('./forkVersion.js').patch;
+        return forkPatch ? '+p' + forkPatch : '';
+    }
+    catch {
+        return '';
+    }
+})();
