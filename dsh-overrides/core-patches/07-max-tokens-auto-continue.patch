+/** dsh-overrides core 07: max-tokens auto-continue — см. step() ниже. */
+/**
+* Лимит авто-продолжений хода, обрезанного лимитом вывода (finish "max-tokens").
+* Env DSH_TUI_MAX_TOKENS_CONTINUE: отсутствие/пусто → 3 (умолчание),
+* число ≥ 0 → floor, битое/отрицательное → 0 (запрещено молча угадывать
+* намерение — безопасный фоллбек = прежнее поведение). 0 = полностью выключено.
+*
+* @returns {number} сколько продолжений допустимо на один TURN
+*/
+function dshPatchMaxTokensContinueLimit() {
+	const raw = process.env.DSH_TUI_MAX_TOKENS_CONTINUE;
+	if (raw === void 0 || raw === null || raw === "") return 3;
+	const parsed = Number(String(raw).trim());
+	if (!Number.isFinite(parsed) || parsed < 0) return 0;
+	return Math.floor(parsed);
+}
