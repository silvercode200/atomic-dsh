#!/usr/bin/env python3
"""dsh-img — превью картинки (URL или локальный путь) не ломая полноэкранный TUI.

Внутри сессии менеджера панелей (env ZELLIJ) картинка открывается в отдельной
плавающей панели; иначе рендер идёт прямо в текущий терминал.

PNG рендерится через kitty graphics protocol (APC-последовательности,
поддерживается WezTerm/kitty и менеджером панелей 0.45+). Остальные форматы —
через chafa, если установлен; без chafa печатается путь к файлу.

Только stdlib. Python 3.10+.
"""
from __future__ import annotations

import argparse
import base64
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import urllib.request

DEFAULT_COLS = 60
DOWNLOAD_TIMEOUT_S = 30
MAX_DOWNLOAD_BYTES = 20 * 1024 * 1024
KITY_CHUNK_B64 = 4096  # максимальная длина base64-чанка в одной APC
ZELLIJ_PANE_NAME = "dsh-img"
TMP_PREFIX = "dsh-img-"
KITTY_TERMS = ("wezterm", "kitty", "xterm-kitty")

# 1x1 RGBA PNG (белый пиксель) — фикстура для --demo, чтобы тестировать без сети.
DEMO_PNG_1X1 = bytes.fromhex(
    "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c489"
    "0000000b49444154789c63f80f040009fb03fdfb5e6b2b0000000049454e44ae426082"
)


def detect_format(head: bytes) -> str | None:
    """Определить формат картинки по magic bytes.

    Args:
        head: первые >=16 байт файла.

    Returns:
        'PNG' | 'JPEG' | 'GIF' | 'WebP' | 'BMP' либо None, если формат не узнан.
    """
    if head.startswith(b"\x89PNG\r\n\x1a\n"):
        return "PNG"
    if head.startswith(b"\xff\xd8\xff"):
        return "JPEG"
    if head[:6] in (b"GIF87a", b"GIF89a"):
        return "GIF"
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "WebP"
    if head.startswith(b"BM"):
        return "BMP"
    return None


def is_url(source: str) -> bool:
    """True, если источник — http/https URL (остальное считается путём)."""
    return source.startswith(("http://", "https://"))


def kitty_supported(env: dict[str, str]) -> bool:
    """Поддерживает ли терминал kitty graphics protocol.

    Внутри сессии менеджера панелей (ZELLIJ/ZELLIJEL в окружении) — да
    (пасстhrоугraphics). Иначе — только если TERM из wezterm/kitty/xterm-kitty.

    Args:
        env: словарь окружения (в тестах — мок, в бою os.environ).
    """
    if env.get("ZELLIJ") or env.get("ZELLIJEL"):
        return True
    term = env.get("TERM", "")
    return any(term.startswith(t) for t in KITTY_TERMS)


def plan_render(fmt: str | None, env: dict[str, str], chafa: str | None) -> str:
    """Выбрать способ рендера файла.

    Args:
        fmt: формат из detect_format (может быть None — неизвестный).
        env: окружение терминала.
        chafa: путь к chafa (shutil.which) или None.

    Returns:
        'kitty' | 'chafa' | 'message'.
    """
    if fmt == "PNG" and kitty_supported(env):
        return "kitty"
    if chafa:
        return "chafa"
    return "message"


def build_kitty_escapes(png: bytes, cols: int) -> str:
    """Собрать kitty graphics APC-последовательности для PNG.

    Формат: ESC _ G <kv-пары через запятую> ';' <base64-payload> ESC \\.
    f=100 — payload = сам PNG; a=T — transmit+display; q=2 — без ответов;
    c=<cols> — ширина в колонках (высота масштабируется с сохранением пропорций).
    Payload режется на чанки <=4096 base64-символов: все кроме последнего с
    m=1, последний с m=0; kv-пары идут только в первом чанке, продолжения —
    только m=1;<chunk>.

    Args:
        png: байты PNG-файла.
        cols: ширина отображения в колонках терминала.

    Returns:
        Строка с одной или несколькими APC-последовательностями.
    """
    payload = base64.b64encode(png).decode("ascii")
    chunks = [payload[i:i + KITY_CHUNK_B64]
              for i in range(0, len(payload), KITY_CHUNK_B64)] or [""]
    parts: list[str] = []
    for i, chunk in enumerate(chunks):
        is_last = i == len(chunks) - 1
        m = 0 if is_last else 1
        if i == 0:
            keys = f"f=100,a=T,q=2,c={cols},m={m}"
        else:
            keys = f"m={m}"
        parts.append("\x1b_G" + keys + ";" + chunk + "\x1b\\")
    return "".join(parts)


def png_dimensions(png: bytes) -> tuple[int, int] | None:
    """(width, height) в пикселях из IHDR-чанка PNG.

    Args:
        png: байты PNG-файла (не менее 24 байт).

    Returns:
        (width, height) либо None, если данные не похожи на PNG/короткие.
    """
    if not png.startswith(b"\x89PNG\r\n\x1a\n") or len(png) < 24:
        return None
    width, height = struct.unpack(">II", png[16:24])
    return width, height


def pane_size_for_png(png: bytes, cols: int) -> tuple[int, int] | None:
    """Оценить размер плавающей панели (width, height) под картинку.

    Kitty масштабирует PNG до cols колонок, высота пропорционально.
    Ячейка терминала ~вдвое выше своей ширины (char_w/char_h ~ 0.5), поэтому
    rows ~ cols * (h/w) * 0.5. Плюс небольшой запас, чтобы не обрезать.

    Args:
        png: байты PNG-файла.
        cols: ширина отображения в колонках.

    Returns:
        (width, height) в колонках/строках либо None, если размер не определить.
    """
    dims = png_dimensions(png)
    if not dims or dims[0] == 0 or dims[1] == 0:
        return None
    w, h = dims
    rows = max(2, round(cols * (h / w) * 0.5))
    return cols + 2, rows + 1


def _read_head(path: str, size: int = 16) -> bytes:
    """Прочитать первые size байт файла (для magic-детекта)."""
    with open(path, "rb") as f:
        return f.read(size)


def _maybe_unlink_tmp(path: str) -> None:
    """Удалить файл, только если это наш временный файл в системном tempdir.

    Локальные файлы пользователя и произвольные пути не трогаем.
    """
    try:
        if (os.path.basename(path).startswith(TMP_PREFIX)
                and os.path.dirname(os.path.abspath(path)) == tempfile.gettempdir()):
            os.unlink(path)
    except OSError:
        pass


def hold_terminal() -> None:
    """Держать панель открытой: молча блокировать stdin до Enter/EOF.

    Ничего не печатаем — панель должна быть чистой (только картинка);
    юзер закрывает её сам (Enter закрывает процесс, панель умирает с
    close-on-exit, либо любой способ закрытия панели менеджера).
    """
    try:
        sys.stdin.readline()
    except (OSError, KeyboardInterrupt):
        pass


def render_file(path: str, cols: int, *, force_kitty: bool = False,
                hold: bool = False) -> int:
    """Отрендерить файл картинки в текущий терминал (stdout).

    PNG идёт kitty-эскейпами (при поддержке терминала), остальное — chafa,
    иначе честное сообщение с путём к файлу. После рендера удаляет файл,
    если это наш временный файл.

    Args:
        path: путь к файлу картинки.
        cols: ширина отображения в колонках.
        force_kitty: пропустить проверку поддержки (режимы --render/--demo:
            решение уже принято родителем/демо всегда рендерит эскейпы).
        hold: блокирующее чтение stdin после рендера (режим плавающей панели).

    Returns:
        Код выхода: 0 — отрендерено, 1 — не смогли (сообщение для юзера).
    """
    head = _read_head(path)
    fmt = detect_format(head)
    chafa = shutil.which("chafa")
    env = dict(os.environ)
    plan = plan_render(fmt, env, chafa)
    if force_kitty and fmt == "PNG":
        plan = "kitty"

    if plan == "kitty":
        with open(path, "rb") as f:
            png = f.read()
        sys.stdout.write(build_kitty_escapes(png, cols) + "\n")
        sys.stdout.flush()
        rc = 0
    elif plan == "chafa":
        assert chafa is not None  # plan_render гарантирует
        rc = subprocess.run([chafa, "--columns", str(cols), path]).returncode
        if rc != 0:
            print(f"[dsh-img] chafa завершился с кодом {rc}; "
                  f"путь к файлу: {path}")
    else:
        if fmt is None:
            print(f"[dsh-img] неизвестный формат файла, chafa не установлен "
                  f"или не нужен — путь к файлу: {path}")
        elif fmt != "PNG":
            print(f"[dsh-img] формат {fmt}: kitty напрямую принимает только "
                  f"PNG, chafa не установлен — путь к файлу: {path}")
        else:
            print(f"[dsh-img] kitty-графика не поддержана "
                  f"(TERM={env.get('TERM', '?')}), chafa не установлен — "
                  f"путь к файлу: {path}")
        rc = 1

    if hold:
        hold_terminal()
    _maybe_unlink_tmp(path)
    return rc


def _zellij_active(env: dict[str, str]) -> bool:
    """Запущены ли мы внутри сессии менеджера панелей."""
    return bool(env.get("ZELLIJ") or env.get("ZELLIJEL"))


def open_zellij_pane(self_exe: str, path: str, cols: int) -> bool:
    """Открыть плавающую безрамочную панель с рендером картинки.

    Вызывает CLI менеджера панелей: action new-pane --floating --name dsh-img
    --borderless true [--width W --height H] --close-on-exit --
    <этот скрипт> --render <file> --cols <cols> (command идёт после --,
    т.к. объявлен как last(true) в CLI 0.45). Ширина/высота подгоняются под
    пропорции PNG, чтобы не было огромного пустого поля.

    Args:
        self_exe: абсолютный путь к этому скрипту.
        path: файл картинки (существует, пока живёт панель).
        cols: ширина отображения в колонках.

    Returns:
        True если панель открыта; False — менеджер недоступен, фолбэк на
        прямой рендер.
    """
    zj = shutil.which("zellij")
    if zj is None:
        candidate = os.path.join(os.path.expanduser("~"), ".local", "bin", "zellij")
        if os.path.isfile(candidate):
            zj = candidate
    if zj is None:
        return False
    cmd = [zj, "action", "new-pane", "--floating", "--name", ZELLIJ_PANE_NAME,
           "--borderless", "true", "--close-on-exit"]
    # Размер панели — только когда картинка PNG (пропорции известны из IHDR).
    try:
        with open(path, "rb") as f:
            head = f.read(24)
        size = pane_size_for_png(head, cols)
    except OSError:
        size = None
    if size is not None:
        cmd += ["--width", str(size[0]), "--height", str(size[1])]
    cmd += ["--", self_exe, "--render", path, "--cols", str(cols)]
    try:
        proc = subprocess.run(cmd, timeout=15, capture_output=True, text=True)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def fetch_url(url: str, dest: str) -> None:
    """Скачать URL в dest (timeout 30s, максимум 20MB).

    Raises:
        urllib.error.URLError / RuntimeError при сетевых проблемах и лимите.
    """
    req = urllib.request.Request(url, headers={"User-Agent": "dsh-img/1.0"})
    total = 0
    with urllib.request.urlopen(req, timeout=DOWNLOAD_TIMEOUT_S) as resp, \
            open(dest, "wb") as out:
        while True:
            chunk = resp.read(65536)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_DOWNLOAD_BYTES:
                raise RuntimeError(f"файл больше {MAX_DOWNLOAD_BYTES} байт: {url}")
            out.write(chunk)


def _write_temp(data: bytes) -> str:
    """Записать байты во временный файл в системном tempdir (наш префикс)."""
    fd, path = tempfile.mkstemp(prefix=TMP_PREFIX, suffix=".png")
    with os.fdopen(fd, "wb") as f:
        f.write(data)
    return path


def main(argv: list[str] | None = None) -> int:
    """Точка входа CLI. Возвращает код выхода процесса."""
    parser = argparse.ArgumentParser(
        prog="dsh-img",
        description="Превью картинки (URL или путь) в плавающей панели "
                    "менеджера окон или в текущем терминале.",
    )
    parser.add_argument("source", nargs="?",
                        help="URL (http/https) или путь к картинке")
    parser.add_argument("--cols", type=int, default=DEFAULT_COLS,
                        help="ширина отображения в колонках (по умолчанию %d)"
                             % DEFAULT_COLS)
    parser.add_argument("--render", metavar="FILE",
                        help="[внутренний] отрендерить файл и держать терминал")
    parser.add_argument("--demo", action="store_true",
                        help="демо: встроенная 1x1 PNG-фикстура (без сети)")
    args = parser.parse_args(argv)
    if args.cols < 1:
        parser.error("--cols должен быть >= 1")

    # Внутренний режим плавающей панели: рендер + блокировка до Enter/EOF.
    if args.render:
        if not os.path.isfile(args.render):
            print(f"[dsh-img] файл не найден: {args.render}", file=sys.stderr)
            return 2
        return render_file(args.render, args.cols, force_kitty=True, hold=True)

    if args.demo:
        path = _write_temp(DEMO_PNG_1X1)
        force_kitty = True  # демо всегда рендерит kitty-эскейпы (для тестов)
    elif args.source:
        force_kitty = False
        if is_url(args.source):
            path = _write_temp(b"")  # скачаем в этот же файл
            try:
                fetch_url(args.source, path)
            except Exception as exc:  # сеть/лимит — юзеру нужен текст ошибки
                _maybe_unlink_tmp(path)
                print(f"[dsh-img] не удалось скачать {args.source}: {exc}",
                      file=sys.stderr)
                return 1
        else:
            path = os.path.abspath(os.path.expanduser(args.source))
            if not os.path.isfile(path):
                print(f"[dsh-img] файл не найден: {path}", file=sys.stderr)
                return 2
            force_kitty = False
    else:
        parser.error("нужен источник: URL/путь или --demo")
        return 2  # pragma: no cover (parser.error сам выходит)

    # Внутри сессии менеджера панелей — плавающая панель с рендером.
    # Только для интерактивного stdout: в пайпе (dsh-img --demo | head) панель
    # не открываем, а рендерим эскейпы прямо в stdout.
    if _zellij_active(dict(os.environ)) and sys.stdout.isatty():
        self_exe = os.path.realpath(__file__)
        if open_zellij_pane(self_exe, path, args.cols):
            print(f"[dsh-img] открыта плавающая панель {ZELLIJ_PANE_NAME} "
                  f"(файл: {path})")
            return 0
        # менеджер недоступен — фолбэк на прямой рендер ниже

    return render_file(path, args.cols, force_kitty=force_kitty)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # юзер закрыл пайп (head -c 20 и т.п.) — это не ошибка
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
